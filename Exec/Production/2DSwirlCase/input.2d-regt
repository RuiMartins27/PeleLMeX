#----------------------DOMAIN DEFINITION------------------------
geometry.is_periodic = 0 0 1                    # For each dir, 0: non-perio, 1: periodic
geometry.coord_sys   = 1                        # 0 => cart, 1 => RZ
geometry.prob_lo     = 0.0   0.0   0.0          # x_lo y_lo (z_lo)
geometry.prob_hi     = 0.0135 0.324 0.001625     # x_hi y_hi (z_hi)    0.0135 0.312 0.001625

# >>>>>>>>>>>>>  BC FLAGS <<<<<<<<<<<<<<<<
# Interior, Inflow, Outflow, Symmetry,
# SlipWallAdiab, NoSlipWallAdiab, SlipWallIsotherm, NoSlipWallIsotherm
peleLM.lo_bc = Symmetry     Inflow      Interior 
peleLM.hi_bc = Inflow       Outflow     Interior 


#-------------------------AMR CONTROL----------------------------
amr.n_cell          = 32 768 4      # Level 0 number of cells in each direction   32 768 4
amr.v               = 1             # AMR verbose
amr.max_level       = 0             # maximum level number allowed
amr.ref_ratio       = 2 2 2 2       # refinement ratio
amr.regrid_int      = 5             # how often to regrid
amr.n_error_buf     = 1 1 2 2       # number of buffer cells in error est
amr.grid_eff        = 0.7           # what constitutes an efficient grid
amr.blocking_factor = 4             # block factor in grid generation (min box size)
amr.max_grid_size   = 32            # max box size

#--------------------------- Problem -------------------------------
prob.P_mean = 101325.0
prob.solidBody = 40000.0

prob.uz = 0.00                      # Axial injection not used for now
prob.inlet_center = 0.010
prob.inlet_delta  = 0.019

prob.ur         = -1.679            # Main Tangential injection     (-1.679 is 10 slm in current setup)
prob.utheta     = 7.75              #                               (7.75 is 10 slm in current setup)
prob.main_center    = 0.063
prob.main_delta     = 0.001
prob.x_O2_main      = 0.00   # 0.00

prob.quench_flag    = 0             # Quench Radial Injection
prob.ur_quench      = -1.81 
prob.quench_center  = 0.1981
prob.quench_delta   = 0.001
prob.x_O2_quench    = 1.00

prob.sponge_gamma   = 1             # Angular Momentum Sponge
prob.sponge_zstart  = 0.27
prob.sponge_zend    = 0.32

prob.total_power = 600              # Power Input
prob.z_center_waveguide = 0.1465
prob.flag_power_shape   = 1         # Static Power Shape (0: uniform cylinder;  1: parabolic)

prob.flag_solve_EM      = 1         # Flag for calling Harps
prob.normalize_power    = 1
prob.EM_t_start         = 0.15
prob.plot_harps_file    = "plt_harps_N2_10slm_600W_corr_"
prob.plot_harps_int     = 500
prob.harps_verbose      = 1
prob.flag_optimize_reflector    = 1     # Flag for optimizing reflector position

#-------------------------PeleLM CONTROL----------------------------
peleLM.v = 1

#amr.restart   = chk_N2_600W_46000
amr.max_step  = 150000
amr.stop_time = 0.75

amr.plot_file   = "plt_N2_10slm_600W_corr_"
amr.check_file  = "chk_N2_10slm_600W_corr_"
amr.check_int   = 1000
amr.plot_int    = 500

peleLM.incompressible = 0
peleLM.rho = 1.17
peleLM.mu = 2.5e-5
peleLM.use_wbar = 0
peleLM.sdc_iterMax = 2
peleLM.floor_species = 1
peleLM.num_init_iter = 3
peleLM.num_init_iter = 5
peleLM.divu_dt_rhoMin = 1e-4

amr.derive_plot_vars = avg_pressure mag_vort mass_fractions chargedistrib angmom
amr.plot_overwrite = true 
amr.plot_init_state = true

#amr.max_dt = 2e-5
#amr.fixed_dt = 1.5e-5
amr.dt_shrink = 0.3
amr.cfl = 0.5
amr.cfl_swirl = 0.5

peleLM.deltaT_iterMax = 20
peleLM.deltaT_crashIfFailing = 0
peleLM.deltaT_tol = 1e-8

peleLM.user_defined_ext_sources = true
peleLM.plot_extSource = true
peleLM.ext_sources_SDC = true

# --------------- INPUTS TO CHEMISTRY REACTOR ---------------
peleLM.chem_integrator = "ReactorCvode"
peleLM.use_typ_vals_chem = 1          # Use species/temp typical values in CVODE
ode.rtol = 1.0e-7                     # Relative tolerance of the chemical solve
ode.atol = 1.0e-6                     # Absolute tolerance factor applied on typical values
ode.clean_init_massfrac = 1
cvode.solve_type = dense_direct       # CVODE Linear solve type (for Newton direction) 
cvode.max_order  = 4                  # CVODE max BDF order. 


